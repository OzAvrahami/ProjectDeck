# ProjectDeck's own Neon PostgreSQL connection string.
DATABASE_URL=

# Server-side provider credentials. Never expose these as NEXT_PUBLIC_* values.
GITHUB_TOKEN=
GITHUB_PROJECTS_TOKEN=
# Dedicated server-only Standard Apply credentials. Neither falls back to the
# read credentials above or to the other write capability.
# User-owned GitHub Project field creation: classic PAT with only `project`.
GITHUB_STANDARD_PROJECTS_WRITE_TOKEN=
# Repository label creation: fine-grained PAT limited to selected repositories
# with Issues: write (GitHub does not provide a label-only permission).
GITHUB_STANDARD_REPOSITORY_WRITE_TOKEN=
# Deprecated compatibility credential for existing manual Railway monitors.
# New Railway connections use OAuth below.
RAILWAY_TOKEN=
VERCEL_TOKEN=

# Provider-level Railway OAuth connection (server-only).
RAILWAY_OAUTH_CLIENT_ID=
RAILWAY_OAUTH_CLIENT_SECRET=
PROJECTDECK_BASE_URL=http://localhost:3000
# Dedicated 32-byte AES key encoded as base64 or 64 hexadecimal characters.
# Generate a base64 value with: openssl rand -base64 32
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# Project-specific PostgreSQL health connections remain server-only. Monitoring
# stores only the variable name, never its value. Example pattern:
# LIFEOS_HEALTH_DATABASE_URL=postgresql://user:password@host/database

# Private single-user access gate. Use a unique password and a random secret
# of at least 32 characters. Both remain server-only.
PROJECTDECK_ACCESS_PASSWORD=
PROJECTDECK_SESSION_SECRET=

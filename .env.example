# ProjectDeck's own Neon PostgreSQL connection string.
DATABASE_URL=

# Server-side provider credentials. Never expose these as NEXT_PUBLIC_* values.
GITHUB_TOKEN=
GITHUB_PROJECTS_TOKEN=
RAILWAY_TOKEN=
VERCEL_TOKEN=

# Project-specific PostgreSQL health connections remain server-only. Monitoring
# stores only the variable name, never its value. Example pattern:
# LIFEOS_HEALTH_DATABASE_URL=postgresql://user:password@host/database

# Private single-user access gate. Use a unique password and a random secret
# of at least 32 characters. Both remain server-only.
PROJECTDECK_ACCESS_PASSWORD=
PROJECTDECK_SESSION_SECRET=
